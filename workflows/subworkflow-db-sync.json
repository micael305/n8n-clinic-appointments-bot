    {
      "parameters": {
        "jsCode": "const eventosOcupados = $input.all().map(item => ({\n  inicio: new Date(item.json.start.dateTime),\n  fin: new Date(item.json.end.dateTime)\n}));\n\nconst disponibilidad = {};\nconst hoyArgentina = $now.setZone('America/Argentina/Tucuman');\n\nfor (let i = 0; i < 7; i++) {\n  if (i === 0) {\n    continue;\n  }\n\n  let fechaActual = hoyArgentina.plus({ days: i }).set({ hour: 12, minute: 0, second: 0, millisecond: 0 });\n  const numeroDiaSemana = fechaActual.weekday; \n\n  if (numeroDiaSemana === 6 || numeroDiaSemana === 7) {\n    continue; \n  }\n\n  let diaLegible = fechaActual.setLocale('es-ES').toFormat('cccc d \\'de\\' MMMM');\n  diaLegible = diaLegible.charAt(0).toUpperCase() + diaLegible.slice(1);\n\n  const slotsDelDia = [];\n\n  for (let hora = 13; hora < 18; hora++) {\n    const slotInicioLuxon = fechaActual.set({ hour: hora, minute: 0, second: 0, millisecond: 0 });\n    const slotFinLuxon = slotInicioLuxon.plus({ hours: 1 });\n\n    const slotInicio = new Date(slotInicioLuxon.toISO());\n    const slotFin = new Date(slotFinLuxon.toISO());\n\n    const conflicto = eventosOcupados.some(evento => {\n      return (slotInicio < evento.fin && slotFin > evento.inicio);\n    });\n\n    if (!conflicto) {\n      const horaLegible = slotInicioLuxon.toFormat('h:mm a');\n      slotsDelDia.push(horaLegible);\n    }\n  }\n\n  if (slotsDelDia.length > 0) {\n    disponibilidad[diaLegible] = slotsDelDia;\n  }\n}\n\nreturn [{ json: { turnosLibres: disponibilidad } }];"
      },
